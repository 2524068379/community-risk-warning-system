{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "main.ts",
    "preload.ts",
    "ollamaManager.ts",
    "ollamaManager.test.ts",
    "security.ts",
    "security.test.ts",
    "vlmResourcePath.ts",
    "vlmResourcePath.test.ts"
  ]
}
